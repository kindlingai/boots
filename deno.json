{
  "name": "@mmastrac/aiboot",
  "version": "0.1.31",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run -A src/main.ts",
    "check": "deno fmt --check && deno lint && deno check src/main.ts",
    "test": "deno test -A tests/",
    "compile": "deno compile -A --include docs -o dist/ai-bootstrap src/main.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "README.md",
      "dist/",
      "build/",
      "docs/prompts/"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    },
    "exclude": [
      "dist/",
      "build/"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/streams": "jsr:@std/streams@^1.2.0"
  }
}
