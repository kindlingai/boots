# The cluster inventory and recipe files.
#
# inventory: one host per line, `#` comments.
#
#   # name     destination            options
#   cp-1       root@10.0.0.10         roles=control
#   worker-1   admin@10.0.0.11:2222   roles=worker sudo
#   gpu-1      root@10.0.0.20         roles=worker,gpu gpu
#   here       local                  roles=bootstrap
#
# `local` runs on the bootstrap machine itself. `sudo` runs the far shell
# under `sudo -n`. `gpu` marks a host that may run the advisor model.
#
# Recipes are `NN-name.md` files, applied in name order, with an optional
# front matter block:
#
#   ---
#   hosts: role:worker            # all | role:<r> | <name>, comma separated
#   verify: systemctl is-active containerd    # repeatable; all must exit 0
#   difficulty: hard              # consult the advisor before starting
#   max_turns: 30
#   ---
#   # Install containerd
#   Free-form instructions for the model...

use std/fs { read_lines, write }
use std/str { trim, split, split_once, starts_with, replace, contains }
use std/list { push, join, includes }
use std/convert { int }

define error BadInventory BadRecipe

struct Host {
  name: string,
  dest: string,
  addr: string,
  port: string,
  roles: string,
  sudo: bool,
  gpu: bool,
}

struct Recipe {
  name: string,
  path: string,
  hosts: string,
  verify: string,
  difficulty: string,
  max_turns: int,
}

fn _words(line: string) -> array<string> {
  out := []
  for w in split(replace(trim(line), "\t", " "), " ") {
    if w != "" {
      push(out, w)
    }
  }
  return out
}

fn _host(words: array<string>) -> Host {
  name := words[0]
  dest := words[1]
  addr := dest
  port := "22"
  if dest != "local" {
    _, rest, has_user := split_once(dest, "@")
    if has_user {
      addr = rest
    }
    if a, p := split_once(addr, ":") {
      addr = a
      port = p
      d, _, _ := split_once(dest, ":")
      dest = d
    }
  }
  roles := ""
  sudo := false
  gpu := false
  i := 2
  while i < words.len {
    w := words[i]
    if starts_with(w, "roles=") {
      _, r, _ := split_once(w, "=")
      roles = r
    } else if w == "sudo" {
      sudo = true
    } else if w == "gpu" {
      gpu = true
    } else {
      throw err("BadInventory", "host ${name}: unknown option ${w}")
    }
    i = i + 1
  }
  return Host { name: name, dest: dest, addr: addr, port: port, roles: roles, sudo: sudo, gpu: gpu }
}

fn no_hosts() -> array<Host> {
  hosts := [Host { name: "", dest: "", addr: "", port: "", roles: "", sudo: false, gpu: false }]
  hosts = []
  return hosts
}

fn load_inventory(file: string) -> array<Host> {
  hosts := no_hosts()
  for line in read_lines(file) {
    t := trim(line)
    if t == "" || starts_with(t, "#") {
      continue
    }
    ws := _words(t)
    if ws.len < 2 {
      throw err("BadInventory", "${file}: need `name destination [options]`: ${t}")
    }
    push(hosts, _host(ws))
  }
  return hosts
}

fn has_role(h: Host, role: string) -> bool {
  return includes(split(h.roles, ","), role)
}

fn describe_host(h: Host) -> string {
  s := "${h.name}: ${h.dest}"
  if h.dest != "local" {
    s = "${s} port ${h.port}"
  }
  if h.roles != "" {
    s = "${s}, roles ${h.roles}"
  }
  if h.sudo {
    s = "${s}, commands run via sudo"
  }
  if h.gpu {
    s = "${s}, has a GPU"
  }
  return s
}

# Hosts matching a comma-separated selector list, in inventory order.
fn select_hosts(hosts: array<Host>, sel: string) -> array<Host> {
  sels := []
  for s in split(sel, ",") {
    if trim(s) != "" {
      push(sels, trim(s))
    }
  }
  for s in sels {
    if s != "all" && !starts_with(s, "role:") {
      found := false
      for h in hosts {
        if h.name == s {
          found = true
        }
      }
      if !found {
        throw err("BadRecipe", "unknown host ${s}")
      }
    }
  }
  out := hosts
  out = []
  for h in hosts {
    want := false
    for s in sels {
      if s == "all" || s == h.name {
        want = true
      } else if starts_with(s, "role:") {
        _, r, _ := split_once(s, ":")
        if has_role(h, r) {
          want = true
        }
      }
    }
    if want {
      push(out, h)
    }
  }
  return out
}

# Parses the front matter and writes the body to `body_out`.
fn load_recipe(file: string, body_out: string) -> Recipe {
  lines := read_lines(file)
  base := file
  while contains(base, "/") {
    _, b, _ := split_once(base, "/")
    base = b
  }
  name := base
  if n, _ := split_once(base, ".md") {
    name = n
  }
  hosts := "all"
  verify := []
  difficulty := "normal"
  max_turns := 30
  start := 0
  if lines.len > 0 && trim(lines[0]) == "---" {
    i := 1
    closed := false
    while i < lines.len && !closed {
      t := trim(lines[i])
      i = i + 1
      if t == "---" {
        closed = true
      } else if t != "" && !starts_with(t, "#") {
        k, v, ok := split_once(t, ":")
        if !ok {
          throw err("BadRecipe", "${file}: front matter wants `key: value`: ${t}")
        }
        k = trim(k)
        v = trim(v)
        if k == "hosts" {
          hosts = v
        } else if k == "verify" {
          push(verify, v)
        } else if k == "difficulty" {
          difficulty = v
        } else if k == "max_turns" {
          max_turns = int(v)
        } else {
          throw err("BadRecipe", "${file}: unknown key ${k}")
        }
      }
    }
    if !closed {
      throw err("BadRecipe", "${file}: front matter is not closed with ---")
    }
    start = i
  }
  body := []
  j := start
  while j < lines.len {
    push(body, lines[j])
    j = j + 1
  }
  write(body_out, join(body, "\n"))
  return Recipe {
    name: name,
    path: file,
    hosts: hosts,
    verify: join(verify, "\n"),
    difficulty: difficulty,
    max_turns: max_turns,
  }
}
