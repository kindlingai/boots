#!/usr/bin/env marsh
# ai-bootstrap: a small local model configures a cluster from recipes.
#
# usage:
#   aiboot.sh [apply] [options] CLUSTER_DIR   configure the cluster
#   aiboot.sh plan CLUSTER_DIR                show which recipe runs where
#   aiboot.sh scrounge [CLUSTER_DIR]          list LLM servers we could borrow
#
# options:
#   --dry-run          the model plans; commands are shown, not run
#   --keep-going       continue past a failed recipe
#   --only NAME        run only this recipe (repeatable)
#   --allow-dangerous  turn off the destructive-command seatbelt
#
# CLUSTER_DIR holds `inventory`, an optional `cluster.md` describing the
# cluster, and `NN-name.md` recipes (see lib/inventory.marsh).

use std/os { env, args, has_cmd, export_env }
use std/fs { exists, is_dir, read, write, mkdir_p, read_lines }
use std/str { trim, split, split_once, starts_with, ends_with, substr }
use std/list { push, join, includes }
use std/convert { int }
use std/time { sleep, instant, diff, to_seconds }
use std/transport { ssh, command }
use std/remote { remote_channel, remote_tx, remote_rx, close, drain }
use std/proc { exit }
use ./lib/far_session { far_worker, session_call, _stale_reset }
use ./lib/inventory { Host, Recipe, no_hosts, load_inventory, select_hosts, describe_host, load_recipe }
use ./lib/llm { Endpoint, no_endpoint, label, scrounge, endpoint_from_row, endpoint_from_spec, healthy, post, ask, works }

define error Aiboot

struct Ctx {
  run: string,
  dir: string,
  dry: bool,
  danger: bool,
  limit: int,
}

struct ChatMsg {
  role: string,
  content: string,
}

struct ToolMsg {
  role: string,
  tool_call_id: string,
  content: string,
}

# ---- output -----------------------------------------------------------------

fn say(s: string) {
  printf '%s\n' "aiboot: ${s}" >&2
}

fn first_line(s: string) -> string {
  l, _, more := split_once(s, "\n")
  if more {
    return "${l} ..."
  }
  return l
}

fn clip(s: string, n: int) -> string {
  if s.len <= n {
    return s
  }
  return "${substr(s, 0, n)}..."
}

# ---- transports -------------------------------------------------------------

# `local` runs on this machine; anything else is an ssh destination.
fn hop(dest: string, port: string) -> transport {
  if dest == "local" {
    return command(["env"])
  }
  a := ["-p", port, "-o", "StrictHostKeyChecking=accept-new", "-o", "ConnectTimeout=10", "-o", "ServerAliveInterval=30", "-o", "LogLevel=ERROR"]
  extra := env("AIBOOT_SSH_OPTS") ?? ""
  for w in split(extra, " ") {
    if w != "" {
      push(a, w)
    }
  }
  push(a, dest)
  return ssh(a)
}

# ---- jq programs ------------------------------------------------------------

fn tools_json() -> string {
  return '''
    [
      {"type": "function", "function": {
        "name": "bash",
        "description": "Run a shell command on the target host and return its output and exit code. One persistent /bin/sh session: cd and exported variables carry over. Use `bash -c '...'` for bash-only syntax.",
        "parameters": {"type": "object", "properties": {
          "command": {"type": "string"}}, "required": ["command"]}}},
      {"type": "function", "function": {
        "name": "read_file",
        "description": "Read a text file on the target host.",
        "parameters": {"type": "object", "properties": {
          "path": {"type": "string"}}, "required": ["path"]}}},
      {"type": "function", "function": {
        "name": "write_file",
        "description": "Create or overwrite a file on the target host with exactly this content. Parent directories must exist.",
        "parameters": {"type": "object", "properties": {
          "path": {"type": "string"}, "content": {"type": "string"},
          "mode": {"type": "string", "description": "octal, e.g. 0644"}},
          "required": ["path", "content"]}}},
      {"type": "function", "function": {
        "name": "consult",
        "description": "Ask a larger, smarter model for advice. Use it when stuck, when an error repeats, or before something risky.",
        "parameters": {"type": "object", "properties": {
          "question": {"type": "string"}}, "required": ["question"]}}},
      {"type": "function", "function": {
        "name": "finish",
        "description": "Declare this recipe done on this host. Its verify checks run next; if they fail you keep working.",
        "parameters": {"type": "object", "properties": {
          "summary": {"type": "string"}}, "required": ["summary"]}}},
      {"type": "function", "function": {
        "name": "give_up",
        "description": "Stop: this recipe cannot be completed on this host. Explain why.",
        "parameters": {"type": "object", "properties": {
          "reason": {"type": "string"}}, "required": ["reason"]}}}
    ]
    '''
}

# Older tool results shrink so a 4B model's context isn't swamped.
fn request_jq() -> string {
  return '''
    length as $n
    | {
        model: $model,
        temperature: 0.2,
        max_tokens: $maxtok,
        tools: $tools[0],
        messages: [ to_entries[] | .key as $i | .value
          | if $i < ($n - 8) and .role == "tool" and ((.content | length) > 600)
            then .content = (.content[0:300] + "\n...[older output elided]...\n" + .content[-300:])
            else . end ]
      }
    '''
}

# Normalizes a response. Servers without native tool parsing leave
# Qwen's <tool_call> tags in the text; recover those.
fn extract_jq() -> string {
  return '''
    .choices[0].message as $m
    | ($m.content // "" | sub("^[\\s\\S]*</think>\\s*"; "")) as $c
    | (if (($m.tool_calls // []) | length) > 0 then $m.tool_calls
       else [ $c | match("<tool_call>\\s*(\\{[\\s\\S]*?\\})\\s*</tool_call>"; "g")
              | .captures[0].string | fromjson? ]
            | map({type: "function", function: {name: .name,
                   arguments: (.arguments | if type == "string" then . else tojson end)}})
       end) as $tc
    | {role: "assistant", content: $c}
      + (if ($tc | length) > 0
         then {tool_calls: [ $tc | to_entries[]
                | .value + {id: (if (.value.id // "") == "" then "call_\(.key)" else .value.id end),
                            type: "function"} ]}
         else {} end)
    '''
}

# Recent actions, for the advisor.
fn recent_jq() -> string {
  return '''
    [inputs] | .[-16:] | map(
      if .role == "tool" then "[result] " + (.content | tostring | .[0:900])
      elif .role == "assistant" then
        ([ (.tool_calls // [])[] | "[" + .function.name + "] " + (.function.arguments | .[0:700]) ]
         + (if (.content // "") != "" then ["[note] " + (.content | .[0:400])] else [] end))
        | join("\n")
      else empty end)
    | join("\n")
    '''
}

fn deny_patterns() -> string {
  return '''
    (^|[;&|[:space:]])rm[[:space:]]+(-[a-zA-Z-]+[[:space:]]+)*-[a-zA-Z]*[rR][a-zA-Z]*[[:space:]]+(-[a-zA-Z-]+[[:space:]]+)*/+(\*|[[:space:]]|$)
    (^|[;&|[:space:]])mkfs(\.[a-z0-9]+)?[[:space:]]
    (^|[;&|[:space:]])dd[[:space:]].*of=/dev/(sd|nvme|vd|xvd|hd|mmcblk)
    (^|[;&|[:space:]])(reboot|poweroff|halt)([[:space:]]|$)
    (^|[;&|[:space:]])shutdown[[:space:]]
    (^|[;&|[:space:]])wipefs[[:space:]]
    '''
}

fn setup_run(c: Ctx) {
  write("${c.run}/tools.json", tools_json())
  write("${c.run}/request.jq", request_jq())
  write("${c.run}/extract.jq", extract_jq())
  write("${c.run}/recent.jq", recent_jq())
  write("${c.run}/deny.txt", deny_patterns() + "\n")
}

# ---- prompts ----------------------------------------------------------------

fn cluster_text(c: Ctx, hosts: array<Host>) -> string {
  lines := []
  for h in hosts {
    push(lines, "- ${describe_host(h)}")
  }
  desc := ""
  if exists("${c.dir}/cluster.md") {
    desc = trim(read("${c.dir}/cluster.md"))
  }
  return "${desc}\n\nInventory:\n${join(lines, "\n")}"
}

fn system_prompt(c: Ctx, hosts: array<Host>, h: Host) -> string {
  return """
    You are ai-bootstrap, an unattended cluster configuration agent. Nobody is
    watching and nobody will answer questions: act, using the tools.

    You are working on host ${h.name}. Every tool runs there.

    Rules:
    - Inspect before changing: OS release, architecture, what is installed.
    - Make every step idempotent: check first, `mkdir -p`, install only if missing.
    - Use non-interactive commands: DEBIAN_FRONTEND=noninteractive apt-get -y, dnf -y.
    - Read errors carefully. If the same thing fails twice, call `consult`.
    - Never reboot, wipe disks, or change SSH or network config unless the recipe says to.
    - When the goal is met, call `finish`. Its checks run automatically.
    - If the goal is impossible here, call `give_up` with the reason.

    The cluster:
    ${cluster_text(c, hosts)}
    """
}

fn task_prompt(r: Recipe, body: string, h: Host) -> string {
  s := "Recipe `${r.name}` on host ${h.name}:\n\n${trim(body)}"
  if r.verify != "" {
    s = "${s}\n\nIt is done when each of these exits 0 on ${h.name}:\n${r.verify}"
  }
  return s
}

fn advisor_system() -> string {
  return """
    You are a senior Linux and infrastructure engineer advising a small
    automation model that is configuring a cluster unattended over SSH.
    Answer with concrete, minimal, idempotent shell steps for the host named.
    Be terse. If the approach so far is wrong, say so and give the right one.
    """
}

# ---- the model server -------------------------------------------------------

fn wait_healthy(e: Endpoint, d: int, what: string) -> bool {
  t0 := instant()
  last := 0
  while to_seconds(diff(t0, instant())) < d {
    if healthy(e) {
      return true
    }
    el := to_seconds(diff(t0, instant()))
    if el - last >= 60 {
      say("still waiting for ${what} (${el}s)")
      last = el
    }
    sleep(5_s)
  }
  return false
}

# The first model id a server lists, or `fallback`.
fn served_model(e: Endpoint, fallback: string) -> string {
  if !?(curl -sf -m 5 -o /tmp/aiboot-models.${pid()} "${e.url}/models") {
    return fallback
  }
  m := trim($(jq -r '(.data // .models // [])[0] | (.id // .name // "")' /tmp/aiboot-models.${pid()}))
  rm -f /tmp/aiboot-models.${pid()}
  if m == "" {
    return fallback
  }
  return m
}

fn worker_endpoint() -> Endpoint {
  port := env("AIBOOT_WORKER_PORT") ?? "18080"
  return Endpoint { url: "http://127.0.0.1:${port}/v1", model: "worker", key_env: "", size: "4", source: "container" }
}

# Explicit URL, a running worker container, a fresh one, or anything
# scrounged as a last resort.
fn resolve_worker(c: Ctx, hosts: array<Host>) -> Endpoint {
  if url := env("AIBOOT_WORKER_URL") {
    e := Endpoint { url: url, model: env("AIBOOT_WORKER_MODEL") ?? "worker", key_env: env("AIBOOT_WORKER_KEY_ENV") ?? "", size: env("AIBOOT_WORKER_SIZE") ?? "4", source: "configured" }
    return Endpoint { url: e.url, model: served_model(e, e.model), key_env: e.key_env, size: e.size, source: e.source }
  }
  e := worker_endpoint()
  if !healthy(e) && has_cmd("docker") {
    image := env("AIBOOT_WORKER_IMAGE") ?? "ghcr.io/mmastrac/ai-bootstrap-worker:latest"
    port := env("AIBOOT_WORKER_PORT") ?? "18080"
    say("starting worker model container ${image}")
    _ := ?(docker rm -f aiboot-worker > /dev/null 2>&1)
    docker run -d --name aiboot-worker --restart unless-stopped -p "127.0.0.1:${port}:8080" $image > /dev/null
    if !wait_healthy(e, 900, "the worker model") {
      throw err("Aiboot", "the worker container never became healthy; see `docker logs aiboot-worker`")
    }
  }
  if healthy(e) {
    return Endpoint { url: e.url, model: served_model(e, "worker"), key_env: "", size: e.size, source: e.source }
  }
  say("no docker and no worker container; looking for a running model to use instead")
  out := "${c.run}/worker-scrounge.tsv"
  if scrounge(c.run, scrounge_hosts(hosts), out) > 0 {
    rows := read_lines(out)
    w := endpoint_from_row(rows[0])
    return Endpoint { url: w.url, model: w.model, key_env: w.key_env, size: w.size, source: w.source }
  }
  throw err("Aiboot", "no worker model: install docker, or set AIBOOT_WORKER_URL")
}

fn scrounge_hosts(hosts: array<Host>) -> array<string> {
  out := ["127.0.0.1"]
  for h in hosts {
    if h.dest != "local" && !includes(out, h.addr) {
      push(out, h.addr)
    }
  }
  for x in split(env("AIBOOT_SCROUNGE_HOSTS") ?? "", ",") {
    if trim(x) != "" && !includes(out, trim(x)) {
      push(out, trim(x))
    }
  }
  return out
}

# ---- the advisor ------------------------------------------------------------

fn _save_advisor(c: Ctx, e: Endpoint) {
  write("${c.run}/advisor.tsv", "${e.url}\t${e.model}\t${e.key_env}\t${e.size}\t${e.source}")
}

fn _load_advisor(c: Ctx) -> Endpoint {
  f := split(read("${c.run}/advisor.tsv"), "\t")
  return Endpoint { url: f[0], model: f[1], key_env: f[2], size: f[3], source: f[4] }
}

# Starts llama.cpp's server on `h` (or locally) and returns its endpoint.
fn launch_advisor(c: Ctx, h: Host, gpu: bool) -> Endpoint {
  model := env("AIBOOT_ADVISOR_MODEL") ?? "unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF:Q4_K_M"
  port := env("AIBOOT_ADVISOR_PORT") ?? "18081"
  image := "ghcr.io/ggml-org/llama.cpp:server"
  flags := ""
  if gpu {
    image = env("AIBOOT_ADVISOR_IMAGE") ?? "ghcr.io/ggml-org/llama.cpp:server-cuda"
    flags = "--gpus all"
  }
  bind := port
  addr := h.addr
  if h.dest == "local" {
    bind = "127.0.0.1:${port}"
    addr = "127.0.0.1"
  }
  key := trim($(od -An -N16 -tx1 /dev/urandom | tr -d " \n"))
  export_env("AIBOOT_ADVISOR_LAUNCH_KEY", key)
  script := "docker rm -f aiboot-advisor >/dev/null 2>&1; docker run -d --name aiboot-advisor --restart unless-stopped ${flags} -p ${bind}:8080 -v aiboot-models:/root/.cache/llama.cpp ${image} -hf ${model} --host 0.0.0.0 --port 8080 --jinja -c 32768 -ngl 999 --api-key ${key} >/dev/null"
  elevate := h.sudo
  say("launching advisor ${model} on ${h.name}")
  hop ${h.dest} ${h.port} {
    if elevate {
      sudo -n sh -c $script
    } else {
      sh -c $script
    }
  }
  e := Endpoint { url: "http://${addr}:${port}/v1", model: model, key_env: "AIBOOT_ADVISOR_LAUNCH_KEY", size: "30", source: "launched on ${h.name}" }
  if !wait_healthy(e, 2700, "the advisor model to download and load") {
    throw err("Aiboot", "the advisor on ${h.name} never became healthy")
  }
  return e
}

# Resolved once per run, on first use: configured, scrounged, launched.
fn advisor(c: Ctx, worker: Endpoint, hosts: array<Host>) -> Endpoint {
  if exists("${c.run}/advisor.tsv") {
    return _load_advisor(c)
  }
  say("looking for an advisor model")
  found := no_endpoint()
  ok := false
  for spec in split(env("AIBOOT_ADVISORS") ?? "", ",") {
    if !ok && trim(spec) != "" {
      e := endpoint_from_spec(trim(spec))
      if works(c.run, e) {
        found = e
        ok = true
      }
    }
  }
  if !ok && (env("AIBOOT_NO_SCROUNGE") ?? "") != "1" {
    out := "${c.run}/advisor-scrounge.tsv"
    n := scrounge(c.run, scrounge_hosts(hosts), out)
    if n > 0 {
      for row in read_lines(out) {
        e := endpoint_from_row(row)
        same := e.url == worker.url
        bigger := ?(awk -v a=${e.size} -v b=${worker.size} 'BEGIN { exit !(a == 0 || a > b) }')
        if !ok && !same && bigger && works(c.run, e) {
          found = e
          ok = true
        }
      }
    }
  }
  if !ok && !c.dry && (env("AIBOOT_NO_LAUNCH") ?? "") != "1" {
    try {
      local := Host { name: "local", dest: "local", addr: "127.0.0.1", port: "22", roles: "", sudo: false, gpu: true }
      if has_cmd("nvidia-smi") && has_cmd("docker") {
        found = launch_advisor(c, local, true)
        ok = true
      } else {
        for h in hosts {
          if !ok && h.gpu {
            found = launch_advisor(c, h, true)
            ok = true
          }
        }
      }
      if !ok && (env("AIBOOT_ADVISOR_CPU") ?? "") == "1" && has_cmd("docker") {
        found = launch_advisor(c, local, false)
        ok = true
      }
    } catch e {
      say("advisor launch failed: ${e.message}")
    }
  }
  if ok {
    say("advisor: ${label(found)}")
  } else {
    say("no advisor available; the worker is on its own")
  }
  _save_advisor(c, found)
  return found
}

fn consult(c: Ctx, worker: Endpoint, hosts: array<Host>, sess: string, h: Host, body: string, question: string) -> string {
  a := advisor(c, worker, hosts)
  if a.url == "" {
    return "No advisor model is available. Work it out carefully yourself."
  }
  recent := $(jq -rn -f "${c.run}/recent.jq" "${sess}/messages.jsonl")
  ctx := "${cluster_text(c, hosts)}\n\nTarget host: ${describe_host(h)}\n\nRecipe:\n${body}\n\nRecent actions on ${h.name}:\n${recent}"
  say("[${h.name}] consulting ${a.model}: ${first_line(clip(question, 120))}")
  try {
    return ask(sess, a, advisor_system(), "${ctx}\n\nQuestion from the automation model:\n${question}")
  } catch e {
    return "The advisor call failed (${e.message}). Continue on your own."
  }
}

# ---- one host session -------------------------------------------------------

fn append_msg(sess: string, line: string) {
  printf '%s\n' $line >> ${sess}/messages.jsonl
}

# (exit code, body) of one far request.
fn far(c: Ctx, cmd_tx: remote_tx, res_rx: remote_rx, req: string) -> (string, string) {
  reply := session_call(cmd_tx, res_rx, req, 16_min)
  if reply == "\x01gone" || reply == "\x01int" || reply == "" {
    return ("255", "error: no reply from the host (connection dropped, or the command outran 15 minutes)")
  }
  head, rest, _ := split_once(reply, "\n")
  rc, _, _ := split_once(head, " ")
  _, body, _ := split_once(rest, "\n")
  return (rc, body)
}

fn run_far(c: Ctx, cmd_tx: remote_tx, res_rx: remote_rx, cmd: string) -> string {
  rc, body := far(c, cmd_tx, res_rx, "bash ${c.limit}\n${cmd}")
  if rc != "0" {
    return "${body}\n(exit ${rc})"
  }
  return body
}

# "" when every check passes, else what failed.
fn verify(c: Ctx, r: Recipe, cmd_tx: remote_tx, res_rx: remote_rx) -> string {
  fails := []
  for check in split(r.verify, "\n") {
    if trim(check) != "" {
      rc, body := far(c, cmd_tx, res_rx, "bash 1500\n${check}")
      if rc != "0" {
        push(fails, "`${check}` exited ${rc}: ${body}")
      }
    }
  }
  return join(fails, "\n")
}

fn denied(c: Ctx, cmd: string) -> bool {
  if c.danger {
    return false
  }
  return ?(printf '%s\n' $cmd | grep -Eqf "${c.run}/deny.txt")
}

# One model turn. Returns the number of tool calls; throws LLM.
fn turn(c: Ctx, worker: Endpoint, sess: string) -> int {
  maxtok := env("AIBOOT_MAX_TOKENS") ?? "2048"
  jq -s -f "${c.run}/request.jq" --arg model ${worker.model} --argjson maxtok $maxtok --slurpfile tools "${c.run}/tools.json" "${sess}/messages.jsonl" > "${sess}/req.json"
  post(sess, worker, "${sess}/req.json", "${sess}/resp.json")
  jq -c -f "${c.run}/extract.jq" "${sess}/resp.json" > "${sess}/turn.json"
  append_msg(sess, trim(read("${sess}/turn.json")))
  return int(trim($(jq '.tool_calls // [] | length' "${sess}/turn.json")))
}

fn tool_result(sess: string, i: int, content: string) {
  id := trim($(jq -r ".tool_calls[${i}].id" "${sess}/turn.json"))
  append_msg(sess, to_json(ToolMsg { role: "tool", tool_call_id: id, content: content }))
}

fn drive(c: Ctx, worker: Endpoint, hosts: array<Host>, r: Recipe, body: string, h: Host, sess: string, cmd_tx: remote_tx, res_rx: remote_rx) -> string {
  append_msg(sess, to_json(ChatMsg { role: "system", content: system_prompt(c, hosts, h) }))
  append_msg(sess, to_json(ChatMsg { role: "user", content: task_prompt(r, body, h) }))
  if r.difficulty == "hard" {
    plan := consult(c, worker, hosts, sess, h, body, "Give a short step-by-step plan for this recipe on ${h.name}.")
    append_msg(sess, to_json(ChatMsg { role: "user", content: "Advice from a senior engineer:\n${plan}" }))
  }
  fails := 0
  nudges := 0
  turns := 0
  while turns < r.max_turns {
    turns = turns + 1
    n := 0
    try {
      n = turn(c, worker, sess)
    } catch e {
      return "failed: worker model error: ${e.message}"
    }
    note := trim($(jq -r '.content // ""' "${sess}/turn.json"))
    if note != "" {
      say("[${h.name}] ${first_line(clip(note, 160))}")
    }
    if n == 0 {
      nudges = nudges + 1
      if nudges > 3 {
        return "failed: the model stopped calling tools"
      }
      append_msg(sess, to_json(ChatMsg { role: "user", content: "Continue by calling a tool. Call `finish` when the recipe is done." }))
      continue
    }
    i := 0
    while i < n {
      name := trim($(jq -r ".tool_calls[${i}].function.name" "${sess}/turn.json"))
      argsf := "${sess}/args.json"
      parsed := ?(jq -c ".tool_calls[${i}].function.arguments | fromjson" "${sess}/turn.json" > $argsf 2>/dev/null)
      result := ""
      if !parsed {
        result = "error: the tool arguments were not valid JSON"
      } else if name == "bash" {
        cmd := $(jq -r '.command // ""' $argsf)
        say("[${h.name}] \$ ${first_line(clip(cmd, 160))}")
        if denied(c, cmd) {
          result = "refused: that command matches a destructive pattern. Find a safer way, or give_up."
        } else if c.dry {
          result = "(dry run: not executed; assume it succeeded)"
        } else {
          result = run_far(c, cmd_tx, res_rx, cmd)
        }
      } else if name == "read_file" {
        rp := $(jq -r '.path // ""' $argsf)
        say("[${h.name}] read ${rp}")
        rrc, rb := far(c, cmd_tx, res_rx, "read ${c.limit} 0 0\n${rp}")
        result = rb
        if rrc != "0" {
          result = "${rb}\n(exit ${rrc})"
        }
      } else if name == "write_file" {
        wp := $(jq -r '.path // ""' $argsf)
        mode := $(jq -r '.mode // ""' $argsf)
        say("[${h.name}] write ${wp}")
        if c.dry {
          result = "(dry run: not written)"
        } else {
          b64 := $(jq -rj '.content // ""' $argsf | base64 | tr -d "\n")
          wrc, wb := far(c, cmd_tx, res_rx, "write ${c.limit}\n${wp}\n${b64}")
          result = wb
          if wrc == "0" && mode != "" {
            result = "${wb}\n${run_far(c, cmd_tx, res_rx, "chmod ${mode} '${wp}'")}"
          } else if wrc != "0" {
            result = "${wb}\n(exit ${wrc})"
          }
        }
      } else if name == "consult" {
        result = consult(c, worker, hosts, sess, h, body, $(jq -r '.question // ""' $argsf))
      } else if name == "give_up" {
        return "failed: ${$(jq -r '.reason // "gave up"' $argsf)}"
      } else if name == "finish" {
        if c.dry {
          return "done: (dry run) ${$(jq -r '.summary // ""' $argsf)}"
        }
        bad := verify(c, r, cmd_tx, res_rx)
        if bad == "" {
          return "done: ${$(jq -r '.summary // ""' $argsf)}"
        }
        fails = fails + 1
        say("[${h.name}] verification failed (${fails})")
        result = "Verification FAILED, keep working:\n${bad}"
        if fails >= 2 {
          advice := consult(c, worker, hosts, sess, h, body, "Verification keeps failing:\n${bad}\nWhat is wrong and what exactly should be done?")
          result = "${result}\n\nAdvice from a senior engineer:\n${advice}"
        }
      } else {
        result = "error: unknown tool ${name}"
      }
      tool_result(sess, i, result)
      i = i + 1
    }
  }
  return "failed: out of turns (${r.max_turns})"
}

# Opens the far shell, checks, drives, closes. Returns the outcome.
fn apply_one(c: Ctx, worker: Endpoint, hosts: array<Host>, r: Recipe, body: string, h: Host) -> string {
  sess := "${c.run}/${r.name}--${h.name}"
  mkdir_p(sess)
  write("${sess}/messages.jsonl", "")
  cmd_rx, cmd_tx := remote_channel()
  res_rx, res_tx := remote_channel()
  elevate := h.sudo
  start hop ${h.dest} ${h.port} {
    far_worker(cmd_rx, res_tx, 15_min, elevate)
    close(res_tx)
  }
  _stale_reset(res_rx)
  outcome := ""
  rc, _ := far(c, cmd_tx, res_rx, "bash 0\n:")
  if rc != "0" {
    outcome = "failed: could not open a shell on ${h.dest}"
  } else if r.verify != "" && verify(c, r, cmd_tx, res_rx) == "" {
    outcome = "skipped: already satisfied"
  } else {
    try {
      outcome = drive(c, worker, hosts, r, body, h, sess, cmd_tx, res_rx)
    } catch e {
      outcome = "failed: ${e.message}"
    }
  }
  close(cmd_tx)
  try {
    for _ in drain(res_rx) {
    }
  } catch e {
  }
  return outcome
}

# ---- main -------------------------------------------------------------------

fn usage() -> ! {
  echo "usage: aiboot [apply|plan|scrounge] [--dry-run] [--keep-going] [--only NAME] [--allow-dangerous] CLUSTER_DIR" >&2
  exit(2)
}

fn recipe_files(dir: string) -> array<string> {
  out := []
  for f in @(ls -1 $dir) {
    if ends_with(f, ".md") && f != "cluster.md" && f != "README.md" {
      push(out, "${dir}/${f}")
    }
  }
  return out
}

mode := "apply"
dir := ""
dry := false
keep_going := false
danger := false
only := []
want_only := false
argv := args()
k := 0
while k < argv.len {
  a := argv[k]
  if k == 0 && (a == "apply" || a == "plan" || a == "scrounge") {
    mode = a
  } else if a == "--dry-run" {
    dry = true
  } else if a == "--keep-going" {
    keep_going = true
  } else if a == "--allow-dangerous" {
    danger = true
  } else if a == "--only" && k + 1 < argv.len {
    k = k + 1
    push(only, argv[k])
    want_only = true
  } else if a == "-h" || a == "--help" || starts_with(a, "-") {
    usage()
  } else {
    dir = a
  }
  k = k + 1
}

for tool in ["curl", "jq", "base64", "awk"] {
  if !has_cmd(tool) {
    say("needs ${tool} on PATH")
    exit(1)
  }
}

hosts := no_hosts()
if dir != "" {
  if !is_dir(dir) || !exists("${dir}/inventory") {
    say("${dir} needs an inventory file")
    exit(2)
  }
  hosts = load_inventory("${dir}/inventory")
} else if mode != "scrounge" {
  usage()
}

stamp := trim($(date +%Y%m%d-%H%M%S))
logs := env("AIBOOT_LOG_DIR") ?? "aiboot-logs"
run := "${logs}/${stamp}"
mkdir_p(run)
c := Ctx { run: run, dir: dir, dry: dry, danger: danger, limit: 6000 }
setup_run(c)

if mode == "scrounge" {
  n := scrounge(run, scrounge_hosts(hosts), "${run}/scrounge.tsv")
  if n == 0 {
    say("nothing found")
  } else {
    cat "${run}/scrounge.tsv"
  }
  exit(0)
}

recipes := []
for f in recipe_files(dir) {
  push(recipes, f)
}

if mode == "plan" {
  for f in recipes {
    r := load_recipe(f, "${run}/body.md")
    names := []
    for h in select_hosts(hosts, r.hosts) {
      push(names, h.name)
    }
    echo "${r.name}  [${r.difficulty}]  -> ${join(names, ", ")}"
  }
  exit(0)
}

worker := resolve_worker(c, hosts)
say("worker: ${label(worker)}")
say("logs: ${run}")

ok_n := 0
fail_n := 0
stop := false
summary := []
for f in recipes {
  if !stop {
    mkdir_p("${run}/recipes")
    bodyf := "${run}/recipes/current.md"
    r2 := load_recipe(f, bodyf)
    if !want_only || includes(only, r2.name) {
      body := read(bodyf)
      for h in select_hosts(hosts, r2.hosts) {
        if !stop {
          say("== ${r2.name} on ${h.name}")
          out := apply_one(c, worker, hosts, r2, body, h)
          say("   ${out}")
          push(summary, "${r2.name} @ ${h.name}: ${out}")
          if starts_with(out, "failed") {
            fail_n = fail_n + 1
            if !keep_going {
              stop = true
            }
          } else {
            ok_n = ok_n + 1
          }
        }
      }
    }
  }
}

echo ""
for line in summary {
  echo "  ${line}"
}
echo "${ok_n} ok, ${fail_n} failed; transcripts in ${run}"
if fail_n > 0 {
  exit(1)
}
